{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village",
  "type": "object",
  "required": [
    "id",
    "name",
    "county",
    "state"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
